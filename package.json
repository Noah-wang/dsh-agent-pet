{
  "name": "dsh-agent-pet",
  "version": "0.2.0",
  "description": "A draggable pet that reacts to DeepSeek Harness agent activity.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent-pet",
    "cordis",
    "web-ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/state.js && node --check lib/pet-config.js && node --check lib/pet-generation.js && node --check lib/pet-store.js",
    "prepack": "npm test && npm run check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "files": [
    "lib",
    "pets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
