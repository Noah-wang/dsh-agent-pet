{
  "name": "dsh-agent-pet",
  "version": "0.4.0",
  "description": "Eight poses, one per agent state — a DeepSeek Harness Web UI pet whose sprite sheet you can generate from one sentence.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "agent-pet",
    "sprite-sheet",
    "mascot",
    "cordis",
    "web-ui"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noah-wang/dsh-agent-pet.git"
  },
  "bugs": {
    "url": "https://github.com/Noah-wang/dsh-agent-pet/issues"
  },
  "homepage": "https://github.com/Noah-wang/dsh-agent-pet#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/state.js && node --check lib/pet-config.js && node --check lib/pet-generation.js && node --check lib/pet-store.js && node --check lib/sprite-sheet.js && node --check lib/pet-prefs.js",
    "prepack": "npm test && npm run check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "files": [
    "lib",
    "pets",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "screenshots.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
